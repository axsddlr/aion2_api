# Virtual environment - installed packages, ~30 MB.
# Recreate with: uv sync
.venv/
venv/
env/

# Python bytecode caches
__pycache__/
*.py[cod]
*$py.class

# Local-only development helpers: kept on this machine, never published.
# capture_xhr.js records a page's network traffic for re-checking the endpoints.
capture_xhr.js
xhr_capture.json

# Local-only: game-session packet capture and the analyser for it.
# Contains your own session traffic - never publish, never commit.
session.pcap
*.pcap
analyze_session.py

# Editors and OS junk
.vscode/
.idea/
.DS_Store
Thumbs.db
